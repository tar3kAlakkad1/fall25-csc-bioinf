from ..trviz.motif_encoder import MotifEncoder
from ..trviz.utils import INDEX_TO_CHR, PRIVATE_MOTIF_LABEL


def test_encode_simple_no_private():
    """Test encoding simple decomposed VNTRs without private motifs."""
    print("Testing encode_simple_no_private...")
    
    encoder = MotifEncoder()
    sample_decomposed_vntrs_simple = [
        ["ACTG", "ACTG", "ACTG"],
        ["ACTG", "TGCA", "ACTG"],
        ["TGCA", "TGCA", "ACTG"],
    ]
    motif_map_file = "/tmp/test_motif_map_simple.txt"
    
    encoded_vntrs = encoder.encode(
        sample_decomposed_vntrs_simple,
        motif_map_file,
        auto=False
    )
    
    # Check that we got encoded strings
    assert len(encoded_vntrs) == 3, "Failed: should have 3 encoded VNTRs"
    assert all(isinstance(vntr, str) for vntr in encoded_vntrs), "Failed: all encoded VNTRs should be strings"
    
    # Check that motif_to_symbol and symbol_to_motif are populated
    assert len(encoder.motif_to_symbol) == 2, "Failed: should have 2 motifs (ACTG and TGCA)"
    assert len(encoder.symbol_to_motif) == 2, "Failed: should have 2 symbols"
    
    # Check bidirectional mapping
    for motif, symbol in encoder.motif_to_symbol.items():
        assert encoder.symbol_to_motif[symbol] == motif, f"Failed: bidirectional mapping for {motif}"
    
    print("✓ test_encode_simple_no_private passed!")


def test_encode_with_auto_private_threshold():
    """Test encoding with automatic private motif threshold."""
    print("Testing encode_with_auto_private_threshold...")
    
    encoder = MotifEncoder()
    sample_decomposed_vntrs_with_rare = [
        ["AAA", "AAA", "AAA", "AAA", "AAA"],  # AAA: 5
        ["AAA", "BBB", "AAA", "BBB", "AAA"],  # BBB: 2
        ["AAA", "CCC", "AAA"],                 # CCC: 1 (rare)
        ["BBB", "DDD", "BBB"],                 # DDD: 1 (rare)
        ["AAA", "BBB", "EEE"],                 # EEE: 1 (rare)
    ]
    motif_map_file = "/tmp/test_motif_map_auto.txt"
    
    encoded_vntrs = encoder.encode(
        sample_decomposed_vntrs_with_rare,
        motif_map_file,
        auto=True
    )
    
    # Check that we got encoded strings
    assert len(encoded_vntrs) == 5, "Failed: should have 5 encoded VNTRs"
    
    # With auto and only 5 unique motifs (less than INDEX_TO_CHR length),
    # all motifs should fit without needing private labels
    # So threshold should be 0
    assert encoder.private_motif_threshold == 0, "Failed: threshold should be 0 with only 5 motifs"
    
    # All motifs should get normal labels
    assert len(encoder.motif_to_symbol) == 5, "Failed: should have 5 motifs encoded"
    
    print("✓ test_encode_with_auto_private_threshold passed!")


def test_encode_with_explicit_threshold():
    """Test encoding with explicit private motif threshold."""
    print("Testing encode_with_explicit_threshold...")
    
    encoder = MotifEncoder(private_motif_threshold=1)
    sample_decomposed_vntrs_with_rare = [
        ["AAA", "AAA", "AAA", "AAA", "AAA"],  # AAA: 10
        ["AAA", "BBB", "AAA", "BBB", "AAA"],  # BBB: 5
        ["AAA", "CCC", "AAA"],                 # CCC: 1 (rare)
        ["BBB", "DDD", "BBB"],                 # DDD: 1 (rare)
        ["AAA", "BBB", "EEE"],                 # EEE: 1 (rare)
    ]
    motif_map_file = "/tmp/test_motif_map_explicit.txt"
    
    encoded_vntrs = encoder.encode(
        sample_decomposed_vntrs_with_rare,
        motif_map_file,
        auto=False
    )
    
    # With threshold=1, motifs with count <= 1 should be private
    assert encoder.private_motif_threshold == 1, "Failed: threshold should be 1"
    
    # Check that rare motifs (count=1) are private
    rare_motifs = ["CCC", "DDD", "EEE"]
    for motif in rare_motifs:
        assert encoder.motif_to_symbol[motif] == PRIVATE_MOTIF_LABEL, f"Failed: {motif} should be private"
    
    print("✓ test_encode_with_explicit_threshold passed!")


def test_encoded_strings_match_input_structure():
    """Test that encoded strings preserve the structure of input."""
    print("Testing encoded_strings_match_input_structure...")
    
    encoder = MotifEncoder()
    sample_decomposed_vntrs_simple = [
        ["ACTG", "ACTG", "ACTG"],
        ["ACTG", "TGCA", "ACTG"],
        ["TGCA", "TGCA", "ACTG"],
    ]
    motif_map_file = "/tmp/test_motif_map_structure.txt"
    
    encoded_vntrs = encoder.encode(
        sample_decomposed_vntrs_simple,
        motif_map_file,
        auto=False
    )
    
    # Check that the length of encoded strings matches the length of decomposed VNTRs
    for i in range(len(sample_decomposed_vntrs_simple)):
        original = sample_decomposed_vntrs_simple[i]
        encoded = encoded_vntrs[i]
        assert len(encoded) == len(original), f"Failed: VNTR {i} length mismatch"
    
    print("✓ test_encoded_strings_match_input_structure passed!")


def test_encoded_strings_use_correct_symbols():
    """Test that encoded strings use the correct symbols for each motif."""
    print("Testing encoded_strings_use_correct_symbols...")
    
    encoder = MotifEncoder()
    sample_decomposed_vntrs_simple = [
        ["ACTG", "ACTG", "ACTG"],
        ["ACTG", "TGCA", "ACTG"],
        ["TGCA", "TGCA", "ACTG"],
    ]
    motif_map_file = "/tmp/test_motif_map_symbols.txt"
    
    encoded_vntrs = encoder.encode(
        sample_decomposed_vntrs_simple,
        motif_map_file,
        auto=False
    )
    
    # Verify that we can decode back to original motifs
    for i in range(len(sample_decomposed_vntrs_simple)):
        original = sample_decomposed_vntrs_simple[i]
        encoded = encoded_vntrs[i]
        decoded = [encoder.symbol_to_motif[symbol] for symbol in encoded]
        for j in range(len(original)):
            assert decoded[j] == original[j], f"Failed: VNTR {i} decoding mismatch at position {j}"
    
    print("✓ test_encoded_strings_use_correct_symbols passed!")


def test_motif_map_file_contents():
    """Test that the motif map file has correct contents."""
    print("Testing motif_map_file_contents...")
    
    encoder = MotifEncoder()
    sample_decomposed_vntrs_simple = [
        ["ACTG", "ACTG", "ACTG"],
        ["ACTG", "TGCA", "ACTG"],
        ["TGCA", "TGCA", "ACTG"],
    ]
    motif_map_file = "/tmp/test_motif_map_contents.txt"
    
    encoder.encode(
        sample_decomposed_vntrs_simple,
        motif_map_file,
        auto=False
    )
    
    # Read the motif map file
    with open(motif_map_file, 'r') as f:
        lines = f.readlines()
    
    # Should have one line per motif
    assert len(lines) == 2, "Failed: should have 2 lines (ACTG and TGCA)"
    
    # Each line should have: motif\tsymbol\tcount
    for line in lines:
        parts = line.strip().split('\t')
        assert len(parts) == 3, "Failed: each line should have 3 parts"
        motif = parts[0]
        symbol = parts[1]
        count = int(parts[2])
        
        # Verify that the symbol matches the encoding
        assert encoder.motif_to_symbol[motif] == symbol, f"Failed: symbol mismatch for {motif}"
        
        # Verify that the count is correct
        assert count == encoder.motif_counter[motif], f"Failed: count mismatch for {motif}"
    
    print("✓ test_motif_map_file_contents passed!")


def test_motif_map_file_ordered_by_frequency():
    """Test that motifs in the map file are ordered by frequency."""
    print("Testing motif_map_file_ordered_by_frequency...")
    
    encoder = MotifEncoder()
    sample_decomposed_vntrs_with_rare = [
        ["AAA", "AAA", "AAA", "AAA", "AAA"],
        ["AAA", "BBB", "AAA", "BBB", "AAA"],
        ["AAA", "CCC", "AAA"],
        ["BBB", "DDD", "BBB"],
        ["AAA", "BBB", "EEE"],
    ]
    motif_map_file = "/tmp/test_motif_map_ordered.txt"
    
    encoder.encode(
        sample_decomposed_vntrs_with_rare,
        motif_map_file,
        auto=False
    )
    
    # Read the motif map file
    with open(motif_map_file, 'r') as f:
        lines = f.readlines()
    
    # Extract counts
    counts = []
    for line in lines:
        parts = line.strip().split('\t')
        counts.append(int(parts[2]))
    
    # Verify that counts are in descending order
    for i in range(len(counts) - 1):
        assert counts[i] >= counts[i + 1], "Failed: motifs should be ordered by frequency"
    
    print("✓ test_motif_map_file_ordered_by_frequency passed!")


def test_find_threshold_without_label_count():
    """Test finding private motif threshold without label_count constraint."""
    print("Testing find_threshold_without_label_count...")
    
    sample_decomposed_vntrs_with_rare = [
        ["AAA", "AAA", "AAA", "AAA", "AAA"],
        ["AAA", "BBB", "AAA", "BBB", "AAA"],
        ["AAA", "CCC", "AAA"],
        ["BBB", "DDD", "BBB"],
        ["AAA", "BBB", "EEE"],
    ]
    
    # With no label_count, all motifs should fit, so threshold should be 0
    threshold = MotifEncoder.find_private_motif_threshold(sample_decomposed_vntrs_with_rare)
    
    # We have 5 unique motifs, which is less than INDEX_TO_CHR length
    # So threshold should be 0
    assert threshold == 0, "Failed: threshold should be 0 when all motifs fit"
    
    print("✓ test_find_threshold_without_label_count passed!")


def test_find_threshold_with_label_count():
    """Test finding private motif threshold with label_count constraint."""
    print("Testing find_threshold_with_label_count...")
    
    sample_decomposed_vntrs_with_rare = [
        ["AAA", "AAA", "AAA", "AAA", "AAA"],
        ["AAA", "BBB", "AAA", "BBB", "AAA"],
        ["AAA", "CCC", "AAA"],
        ["BBB", "DDD", "BBB"],
        ["AAA", "BBB", "EEE"],
    ]
    
    # With label_count=3, we can only encode 2 normal motifs (1 reserved for private)
    threshold = MotifEncoder.find_private_motif_threshold(
        sample_decomposed_vntrs_with_rare,
        label_count=3
    )
    
    # We have: AAA (10), BBB (5), CCC (1), DDD (1), EEE (1)
    # With label_count=3, maximum_label_count=2, so we keep first 2 motifs (AAA, BBB)
    # The threshold is the count of the 3rd motif (CCC), which is 1
    assert threshold == 1, "Failed: threshold should be 1 with label_count=3"
    
    print("✓ test_find_threshold_with_label_count passed!")


def test_find_threshold_with_small_label_count():
    """Test finding private motif threshold with very small label_count."""
    print("Testing find_threshold_with_small_label_count...")
    
    sample_decomposed_vntrs_with_rare = [
        ["AAA", "AAA", "AAA", "AAA", "AAA"],
        ["AAA", "BBB", "AAA", "BBB", "AAA"],
        ["AAA", "CCC", "AAA"],
        ["BBB", "DDD", "BBB"],
        ["AAA", "BBB", "EEE"],
    ]
    
    # With label_count=2, we can only encode 1 normal motif
    threshold = MotifEncoder.find_private_motif_threshold(
        sample_decomposed_vntrs_with_rare,
        label_count=2
    )
    
    # We have: AAA (10), BBB (5), CCC (1), DDD (1), EEE (1)
    # With label_count=2, maximum_label_count=1, so we keep first 1 motif (AAA)
    # The threshold is the count of the 2nd motif (BBB), which is 5
    assert threshold == 5, "Failed: threshold should be 5 with label_count=2"
    
    print("✓ test_find_threshold_with_small_label_count passed!")


def test_symbol_to_motif_bidirectional():
    """Test that symbol_to_motif and motif_to_symbol are consistent."""
    print("Testing symbol_to_motif_bidirectional...")
    
    encoder = MotifEncoder()
    sample_decomposed_vntrs_simple = [
        ["ACTG", "ACTG", "ACTG"],
        ["ACTG", "TGCA", "ACTG"],
        ["TGCA", "TGCA", "ACTG"],
    ]
    motif_map_file = "/tmp/test_motif_map_bidirectional.txt"
    
    encoder.encode(
        sample_decomposed_vntrs_simple,
        motif_map_file,
        auto=False
    )
    
    # Check bidirectional consistency
    for motif, symbol in encoder.motif_to_symbol.items():
        assert encoder.symbol_to_motif[symbol] == motif, f"Failed: bidirectional check 1 for {motif}"
    
    for symbol, motif in encoder.symbol_to_motif.items():
        assert encoder.motif_to_symbol[motif] == symbol, f"Failed: bidirectional check 2 for {symbol}"
    
    print("✓ test_symbol_to_motif_bidirectional passed!")


def test_symbols_are_valid_ascii():
    """Test that all symbols are valid ASCII characters from INDEX_TO_CHR."""
    print("Testing symbols_are_valid_ascii...")
    
    encoder = MotifEncoder()
    sample_decomposed_vntrs_simple = [
        ["ACTG", "ACTG", "ACTG"],
        ["ACTG", "TGCA", "ACTG"],
        ["TGCA", "TGCA", "ACTG"],
    ]
    motif_map_file = "/tmp/test_motif_map_ascii.txt"
    
    encoder.encode(
        sample_decomposed_vntrs_simple,
        motif_map_file,
        auto=False
    )
    
    # Check that all symbols are in INDEX_TO_CHR or PRIVATE_MOTIF_LABEL
    for symbol in encoder.symbol_to_motif.keys():
        assert symbol in INDEX_TO_CHR or symbol == PRIVATE_MOTIF_LABEL, f"Failed: invalid symbol {symbol}"
    
    print("✓ test_symbols_are_valid_ascii passed!")


def test_private_motifs_all_map_to_same_symbol():
    """Test that all private motifs map to PRIVATE_MOTIF_LABEL."""
    print("Testing private_motifs_all_map_to_same_symbol...")
    
    encoder = MotifEncoder(private_motif_threshold=1)
    sample_decomposed_vntrs_with_rare = [
        ["AAA", "AAA", "AAA", "AAA", "AAA"],
        ["AAA", "BBB", "AAA", "BBB", "AAA"],
        ["AAA", "CCC", "AAA"],
        ["BBB", "DDD", "BBB"],
        ["AAA", "BBB", "EEE"],
    ]
    motif_map_file = "/tmp/test_motif_map_private.txt"
    
    encoder.encode(
        sample_decomposed_vntrs_with_rare,
        motif_map_file,
        auto=False
    )
    
    # Find all private motifs (count <= 1)
    private_motifs = []
    for motif, count in encoder.motif_counter.items():
        if count <= 1:
            private_motifs.append(motif)
    
    # Check that they all map to PRIVATE_MOTIF_LABEL
    for motif in private_motifs:
        assert encoder.motif_to_symbol[motif] == PRIVATE_MOTIF_LABEL, f"Failed: {motif} should map to PRIVATE_MOTIF_LABEL"
    
    print("✓ test_private_motifs_all_map_to_same_symbol passed!")




def test_encode_with_label_count():
    """Test encoding with explicit label_count."""
    print("Testing encode_with_label_count...")
    
    encoder = MotifEncoder()
    sample_decomposed_vntrs_with_rare = [
        ["AAA", "AAA", "AAA", "AAA", "AAA"],
        ["AAA", "BBB", "AAA", "BBB", "AAA"],
        ["AAA", "CCC", "AAA"],
        ["BBB", "DDD", "BBB"],
        ["AAA", "BBB", "EEE"],
    ]
    motif_map_file = "/tmp/test_motif_map_label_count.txt"
    
    # Use label_count=3 to force private motif threshold
    encoded_vntrs = encoder.encode(
        sample_decomposed_vntrs_with_rare,
        motif_map_file,
        label_count=3,
        auto=False
    )
    
    # Check that threshold was set correctly
    assert encoder.private_motif_threshold == 1, "Failed: threshold should be 1"
    
    # Check that we only have 2 normal motifs + 1 private label = 3 symbols
    assert len(encoder.symbol_to_motif) == 3, "Failed: should have 3 symbols total"
    
    # Check that PRIVATE_MOTIF_LABEL is one of the symbols
    assert PRIVATE_MOTIF_LABEL in encoder.symbol_to_motif, "Failed: should have PRIVATE_MOTIF_LABEL"
    
    print("✓ test_encode_with_label_count passed!")


def test_encode_empty_vntrs():
    """Test encoding with empty VNTRs list."""
    print("Testing encode_empty_vntrs...")
    
    encoder = MotifEncoder()
    empty_vntrs: list[list[str]] = []
    motif_map_file = "/tmp/test_motif_map_empty.txt"
    
    encoded_vntrs = encoder.encode(
        empty_vntrs,
        motif_map_file,
        auto=False
    )
    
    assert len(encoded_vntrs) == 0, "Failed: should have 0 encoded VNTRs"
    assert len(encoder.motif_to_symbol) == 0, "Failed: should have 0 motif mappings"
    assert len(encoder.symbol_to_motif) == 0, "Failed: should have 0 symbol mappings"
    
    print("✓ test_encode_empty_vntrs passed!")


def test_encode_single_motif():
    """Test encoding with single motif repeated."""
    print("Testing encode_single_motif...")
    
    encoder = MotifEncoder()
    decomposed_vntrs = [
        ["AAA", "AAA", "AAA"],
        ["AAA", "AAA"],
    ]
    motif_map_file = "/tmp/test_motif_map_single.txt"
    
    encoded_vntrs = encoder.encode(
        decomposed_vntrs,
        motif_map_file,
        auto=False
    )
    
    # Should have exactly one symbol
    assert len(encoder.symbol_to_motif) == 1, "Failed: should have 1 symbol"
    assert len(encoder.motif_to_symbol) == 1, "Failed: should have 1 motif"
    
    # All encoded VNTRs should use the same symbol
    symbol = list(encoder.symbol_to_motif.keys())[0]
    assert encoded_vntrs[0] == symbol * 3, "Failed: first VNTR should be 3 repetitions"
    assert encoded_vntrs[1] == symbol * 2, "Failed: second VNTR should be 2 repetitions"
    
    print("✓ test_encode_single_motif passed!")


def test_encode_vntrs_with_single_occurrence_each():
    """Test encoding VNTRs where each motif occurs exactly once."""
    print("Testing encode_vntrs_with_single_occurrence_each...")
    
    encoder = MotifEncoder()
    decomposed_vntrs = [
        ["AAA"],
        ["BBB"],
        ["CCC"],
    ]
    motif_map_file = "/tmp/test_motif_map_single_occurrence.txt"
    
    encoded_vntrs = encoder.encode(
        decomposed_vntrs,
        motif_map_file,
        auto=False
    )
    
    # Each motif should get its own symbol
    assert len(encoder.symbol_to_motif) == 3, "Failed: should have 3 symbols"
    assert len(encoder.motif_to_symbol) == 3, "Failed: should have 3 motifs"
    
    # Each encoded VNTR should be a single character
    assert all(len(vntr) == 1 for vntr in encoded_vntrs), "Failed: each encoded VNTR should be single char"
    
    # All encoded VNTRs should use different symbols
    unique_symbols = set(encoded_vntrs)
    assert len(unique_symbols) == 3, "Failed: should have 3 unique symbols"
    
    print("✓ test_encode_vntrs_with_single_occurrence_each passed!")


def run_all_tests():
    """ Run all test functions """
    print("=" * 60)
    print("Running all tests for motif_encoder.codon")
    print("=" * 60)
    print()
    
    test_encode_simple_no_private()
    print()
    test_encode_with_auto_private_threshold()
    print()
    test_encode_with_explicit_threshold()
    print()
    test_encoded_strings_match_input_structure()
    print()
    test_encoded_strings_use_correct_symbols()
    print()
    test_motif_map_file_contents()
    print()
    test_motif_map_file_ordered_by_frequency()
    print()
    test_find_threshold_without_label_count()
    print()
    test_find_threshold_with_label_count()
    print()
    test_find_threshold_with_small_label_count()
    print()
    test_symbol_to_motif_bidirectional()
    print()
    test_symbols_are_valid_ascii()
    print()
    test_private_motifs_all_map_to_same_symbol()
    print()
    test_encode_with_label_count()
    print()
    test_encode_empty_vntrs()
    print()
    test_encode_single_motif()
    print()
    test_encode_vntrs_with_single_occurrence_each()
    print()
    
    print("=" * 60)
    print("✓ ALL TESTS PASSED!")
    print("=" * 60)


# Run tests when script is executed
run_all_tests()

