from dbg import DBG
from utils import read_data
import sys

BASE_DIR = '/Users/tarekalakkadp/Desktop/uvic/fourth-year/fall/csc427/fall25-csc-bioinf/week1/code/codon/genome-assembly/'

if __name__ == "__main__":
    argv = sys.argv
    data_dir = BASE_DIR + argv[1]
    short1, short2, long1 = read_data(data_dir)

    k = 25
    dbg = DBG(k=k, data_list=[short1, short2, long1])
    # dbg.show_count_distribution()
    with open(data_dir + '/contig.fasta', 'w') as f:
        for i in range(20):
            c = dbg.get_longest_contig()
            if c is None:
                break
            print(i, len(c))
            f.write('>contig_%d\n' % i)
            f.write(c + '\n')